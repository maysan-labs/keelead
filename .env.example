# KeeLead Environment Configuration

# Database
# The Prisma datasource is `url = env("DATABASE_URL")` (upstream hardcoded this path, which
# made the variable a no-op). SQLite by default; any Prisma-supported URL works.
DATABASE_URL="file:./prisma/keelead.db"

# AI Providers (configure in Settings UI or here)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""
NVIDIA_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Custom AI Provider
CUSTOM_AI_ENDPOINT=""
CUSTOM_AI_API_KEY=""
CUSTOM_AI_MODEL=""

# Proxy Configuration
PROXY_URL=""
PROXY_ROTATION="false"

# Notifications
SLACK_WEBHOOK_URL=""
DISCORD_WEBHOOK_URL=""

# CRM Integration
HUBSPOT_API_KEY=""
SALESFORCE_API_KEY=""
SALESFORCE_INSTANCE_URL=""

# Google Sheets
GOOGLE_SHEETS_API_KEY=""

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Maysan Labs deployment (dokploy-compose.yml)
# ---------------------------------------------------------------------------
# DATABASE_URL is what the app actually reads — the Prisma datasource is
# `url = env("DATABASE_URL")`. In the deployed stack it points at the volume:
#   DATABASE_URL=file:/app/data/keelead.db
# NEXT_PUBLIC_APP_URL is inlined into the client bundle at BUILD time.
#
# The auth-proxy service refuses to start without these two (see proxy/):
BASIC_AUTH_USER=""
BASIC_AUTH_PASSWORD=""

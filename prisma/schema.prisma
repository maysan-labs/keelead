generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Maysan Labs: upstream hardcoded "file:./keelead.db" here, which made the DATABASE_URL
  // documented in the README/.env.example/.docker-compose a no-op — `prisma db push` and the
  // app both ignored it and wrote to prisma/keelead.db inside the image. Reading the
  // environment is what lets the database live on the mounted volume (and is the only way
  // to switch to Postgres without editing the schema).
  url      = env("DATABASE_URL")
}

model Lead {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  company     String?
  title       String?
  website     String?
  linkedin    String?
  location    String?
  source      String?
  status      String   @default("new") // new, contacted, qualified, converted, lost
  score       Int      @default(0)
  verified    Boolean  @default(false)
  tags        String?  // JSON array of tags
  notes       String?
  metadata    String?  // JSON object for extra data
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  activities  LeadActivity[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([company])
  @@index([status])
  @@index([score])
  @@index([campaignId])
  @@index([createdAt])
}

// Maysan Labs: every change to a lead is recorded, so "who moved this lead, when, and why" has an
// answer. A pipeline board that cannot produce that trail is a demo; this is what a client's due
// diligence asks for, and it is the only way a status change is auditable rather than assumed.
model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String // created, status_change, note, contacted, consent, suppressed, exported
  fromValue String?
  toValue   String?
  detail    String?
  actor     String   @default("system")
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
}

// Consent and withdrawal records. Compliance reporting may only state what is recorded HERE — the
// UI reads this table and says "not recorded" where it is empty, rather than claiming GDPR hygiene
// nobody can evidence.
model ConsentRecord {
  id         String   @id @default(cuid())
  subject    String // the email address, phone number or domain the record applies to
  channel    String   @default("email") // email, whatsapp, phone
  status     String // granted, withdrawn, unknown
  basis      String? // consent, legitimate_interest, contract
  evidence   String? // where it came from (form URL, message id, call note)
  source     String?
  recordedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([subject, channel])
  @@index([status])
}

// The do-not-contact list. It is applied on export, so a suppressed contact cannot leave the system
// by accident — the requirement is only met if the check sits on the way out, not in a UI note.
model Suppression {
  id        String   @id @default(cuid())
  value     String   @unique // email address, phone number or domain
  kind      String   @default("email") // email, phone, domain
  reason    String // opted_out, bounced, complained, manual
  note      String?
  createdAt DateTime @default(now())

  @@index([kind])
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  description String?
  status      String   @default("draft") // draft, active, paused, completed
  type        String   @default("email") // email, linkedin, phone, multi
  targetLeads Int      @default(0)
  sentCount   Int      @default(0)
  openRate    Float    @default(0)
  replyRate   Float    @default(0)
  metadata    String?  // JSON object
  leads       Lead[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Conversation {
  id        String    @id @default(cuid())
  title     String?
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String       @id @default(cuid())
  role           String       // user, assistant, system
  content        String
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  metadata       String?      // JSON for lead results, etc.
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model VerificationLog {
  id        String   @id @default(cuid())
  email     String
  result    String   // JSON with verification details
  score     Int
  status    String   // valid, invalid, catch-all, disposable, unknown
  createdAt DateTime @default(now())

  @@index([email])
}

model ExportLog {
  id        String   @id @default(cuid())
  format    String   // csv, json, xlsx, vcard, pdf
  count     Int
  filters   String?  // JSON filters applied
  filePath  String?
  createdAt DateTime @default(now())
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String // JSON value
}

// Maysan Labs: every search is recorded. Upstream showed "Searches Today: 156" from a
// hardcoded constant; this table is what makes that number (and the activity feed) real.
model SearchLog {
  id         String   @id @default(cuid())
  query      String
  sources    String? // JSON array of source names that ran
  leadsFound Int      @default(0)
  leadsSaved Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
